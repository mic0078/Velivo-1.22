<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 💬 przeniesienie komunikatora klawiatura -> przeglądarka: tylko między aplikacjami Velivo (ten sam podpis) -->
    <permission android:name="pl.velivo.permission.KOMUNIKATOR" android:protectionLevel="signature" />
    <uses-permission android:name="pl.velivo.permission.KOMUNIKATOR" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 📹 rozmowa wideo w komunikatorze (kamera i mikrofon tylko w trakcie rozmowy) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- 🎨 Tapeta Velivo - tylko po wyborze w menu -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 📍 lokalizacja w komunikatorze - tylko po wybraniu „Moja lokalizacja” -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 📱 filmy i muzyka z telefonu (lista wszystkich) - tylko gdy użytkownik ją otworzy -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- ⏰ pobudka: budzik o dokładnej godzinie (Android 14+: za zgodą użytkownika; wersja pełna ma dodatkowo USE_EXACT_ALARM) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- ⌨ klawiatura Velivo (osobna aplikacja) - menu otwiera jej ustawienia -->
    <queries><package android:name="pl.velivo.klawiatura" /><package android:name="pl.velivo.komunikator" /></queries>
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:usesCleartextTraffic="true"
        android:largeHeap="true"
        android:theme="@style/Velivo">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- Udostępnij → Velivo: wysłanie pliku do sparowanego komputera -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- 💬 osobna ikona „Komunikator Velivo” w menu aplikacji - otwiera od razu komunikator -->
        <activity-alias android:name=".KomunikatorStart" android:targetActivity=".MainActivity" android:exported="true"
            android:label="@string/messenger_app" android:icon="@mipmap/ic_komunikator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- odtwarzacz filmów i telewizji: pełny ekran, obraz w obrazie -->
        <activity
            android:name=".PlayerActivity"
            android:exported="true"
            android:theme="@style/Velivo.Player"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize">
            <!-- "Otwórz za pomocą → Velivo": film z Galerii, Plików, WhatsAppa (Velivo jako domyślny odtwarzacz, gdy ktoś chce) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="video/*" />
                <data android:scheme="file" android:mimeType="video/*" />
                <data android:scheme="http" android:mimeType="video/*" />
                <data android:scheme="https" android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="audio/*" />
                <data android:scheme="file" android:mimeType="audio/*" />
            </intent-filter>
        </activity>
        <!-- widżet na pulpit: szukaj, YouTube, karteczki -->
        <receiver android:name=".Widzet" android:exported="true" android:label="Velivo">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widzet_velivo" />
        </receiver>
        <!-- 💬 aplikacja Komunikator Velivo przejmuje stąd kontakty i rozmowy (tylko aplikacje Velivo - ten sam podpis) -->
        <provider android:name=".KomunikatorDane" android:authorities="pl.velivo.browser.komunikator" android:exported="true"
            android:permission="pl.velivo.permission.KOMUNIKATOR" />
        <receiver android:name="pl.velivo.komunikator.KomunikatorAkcja" android:exported="false" />
        <!-- 💬 komunikator w domowym Wi-Fi: czeka na wiadomości, gdy aplikacja zamknięta (powiadomienia jak w innych komunikatorach) -->
        <service android:name="pl.velivo.komunikator.KomunikatorUsluga" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Local network messenger: receives messages from devices on the home Wi-Fi without internet" />
        </service>
        <service
            android:name=".Odswiezanie"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- karteczki: codzienne sprawdzenie terminów (także po włączeniu telefonu) -->
        <receiver android:name=".Karteczki$Przypomnienie" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
