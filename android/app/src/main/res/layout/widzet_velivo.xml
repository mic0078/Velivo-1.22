<?xml version="1.0" encoding="utf-8"?>
<!-- widżet na pulpit: szukaj, YouTube, karteczki (najbliższe terminy) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/widzet_tlo">
    <TextView android:id="@+id/w_szukaj" android:layout_width="match_parent" android:layout_height="44dp"
        android:background="@drawable/widzet_pole" android:gravity="center_vertical" android:paddingStart="14dp"
        android:text="@string/widget_search" android:textColor="#B9B0E0" android:textSize="16sp" android:contentDescription="@string/widget_search" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_yt" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:background="@drawable/widzet_yt" android:gravity="center" android:text="▶ YouTube" android:textColor="#FFFFFF" android:textSize="16sp"
            android:contentDescription="@string/youtube_plain" />
        <TextView android:id="@+id/w_notatki" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="8dp" android:background="@drawable/widzet_pole" android:gravity="center" android:text="@string/widget_notes"
            android:textColor="#ECE8FF" android:textSize="16sp" android:contentDescription="@string/notes" />
    </LinearLayout>
    <TextView android:id="@+id/w_lista" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:paddingStart="6dp" android:paddingEnd="6dp" android:textColor="#ECE8FF" android:textSize="15sp" android:lineSpacingExtra="4dp" android:maxLines="4" android:ellipsize="end" />
</LinearLayout>
