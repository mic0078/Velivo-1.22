<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 🎤 dyktowanie - tylko po stuknięciu mikrofonu -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 🎞 GIF-y z telefonu w klawiaturze - tylko po zgodzie w ustawieniach klawiatury -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- 💬 przeniesienie komunikatora klawiatura -> przeglądarka: tylko między aplikacjami Velivo (ten sam podpis) -->
    <permission android:name="pl.velivo.permission.KOMUNIKATOR" android:protectionLevel="signature" />
    <uses-permission android:name="pl.velivo.permission.KOMUNIKATOR" />

    <!-- 💬 komunikator i pliki w sieci domowej (bez internetu - tylko Wi-Fi w domu) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 📹 rozmowa wideo w komunikatorze (kamera i mikrofon tylko w trakcie rozmowy) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 📍 lokalizacja w komunikatorze - tylko po wybraniu „Moja lokalizacja” -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- dyktowanie: usługa rozpoznawania mowy w telefonie -->
    <queries><intent><action android:name="android.speech.RecognitionService" /></intent>
        <!-- karteczki, szukanie i YouTube otwierane w przeglądarce Velivo -->
        <package android:name="pl.velivo.browser" /><package android:name="pl.velivo.komunikator" /></queries>
    <application android:label="@string/kb_name" android:icon="@mipmap/ic_launcher" android:allowBackup="false" android:supportsRtl="true"
        android:theme="@style/Velivo.Klawiatura">
        <activity android:name=".Ustawienia" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- ⠿ nauka brajla (poznawanie i ćwiczenia) -->
        <activity android:name=".NaukaBrajla" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />
        <!-- okienka z klawiatury (motyw, wysokość, słownik, mikrofon) - przezroczyste, bez ekranu ustawień pod spodem -->
        <activity android:name=".SzybkieUstawienia" android:exported="false" android:theme="@style/Okienko"
            android:excludeFromRecents="true" android:taskAffinity="" android:noHistory="true" />
        <!-- 💬 komunikator i pliki telefon <-> telefon (gdy nie ma przeglądarki Velivo) - ciemne okienka Velivo -->
        <activity android:name=".Rozmowy" android:exported="false" android:theme="@style/Okienko" android:excludeFromRecents="true" android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize" />
        <!-- 💬 osobna ikona komunikatora - tylko gdy nie ma przeglądarki Velivo (wtedy ikona jest w niej; klawiatura ją wyłącza, bez dublowania) -->
        <activity-alias android:name=".KomunikatorStart" android:targetActivity=".Rozmowy" android:exported="true"
            android:label="@string/kb_messenger_app" android:icon="@mipmap/ic_komunikator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <receiver android:name="pl.velivo.komunikator.KomunikatorAkcja" android:exported="false" />
        <!-- 💬 komunikator w domowym Wi-Fi: czeka na wiadomości, gdy aplikacja zamknięta (powiadomienia jak w innych komunikatorach) -->
        <service android:name="pl.velivo.komunikator.SterowanieUsluga" android:exported="true" android:label="@string/ster_nazwa" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/sterowanie" />
        </service>
        <service android:name="pl.velivo.komunikator.EkranUsluga" android:exported="false" android:foregroundServiceType="mediaProjection|microphone" />
        <service android:name="pl.velivo.komunikator.KomunikatorUsluga" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Local network messenger: receives messages from devices on the home Wi-Fi without internet" />
        </service>
        <!-- 🎞 GIF wysyłany z klawiatury - tylko do aplikacji, w której piszesz (jednorazowe prawo odczytu) -->
        <provider android:name=".GifDane" android:authorities="pl.velivo.klawiatura.gif" android:exported="false" android:grantUriPermissions="true" />
        <provider android:name=".KomunikatorDane" android:authorities="pl.velivo.klawiatura.komunikator" android:exported="true"
            android:permission="pl.velivo.permission.KOMUNIKATOR" />
        <!-- ⌨ klawiatura (włączana w ustawieniach Androida, działa we wszystkich aplikacjach) -->
        <service android:name=".KlawiaturaVelivo" android:label="@string/kb_name" android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter><action android:name="android.view.InputMethod" /></intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/klawiatura_velivo" />
        </service>
    </application>
</manifest>
