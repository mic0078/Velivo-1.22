<?xml version="1.0" encoding="utf-8"?>
<!-- tło okienek klawiatury: ciemny gradient Velivo z fioletową ramką (jak klawiatura i Velivo) -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <shape android:shape="rectangle">
        <gradient android:startColor="#1E1838" android:centerColor="#191B33" android:endColor="#132A35" android:angle="315" />
        <corners android:radius="18dp" />
        <stroke android:width="1dp" android:color="#908B5CF6" />
    </shape>
</inset>
