<Project Sdk="Microsoft.NET.Sdk">
  <!-- Velivo Audio Balance for Windows: CAŁKOWICIE SAMODZIELNY program (bez przeglądarki Velivo) - cały dźwięk Windows (gry, filmy, przeglądarki, muzyka).
       Dźwięk: Windows → VB-Audio Virtual Cable (CABLE Input) → ten program (CABLE Output) → kompresor, LUFS, limiter → Twoje głośniki.
       Wspólny silnik dźwięku z ..\src (AudioBalanceDsp, AudioBalanceDynamics, AudioBalanceDynamicsUi); własne: Silnik\ (VST3), własne teksty (Teksty.cs); z ..\src także AbStyl, AbWidok, VelivoBledy, CentrumZasobnik. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);AB_SAMODZIELNY</DefineConstants>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>VelivoAudioBalance</AssemblyName>
    <Product>Velivo Audio Balance for Windows</Product>
    <AssemblyTitle>Velivo Audio Balance for Windows</AssemblyTitle>
    <Company>andro</Company>
    <RootNamespace>Velivo</RootNamespace>
    <ApplicationIcon>audiobalance.ico</ApplicationIcon>
    <Version>1.22</Version>
    <SatelliteResourceLanguages>pl</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="Silnik\*.cs" />
    <!-- 🎚 jeden wspólny silnik dźwięku z Velivo (2026-11-19, właściciel: „zrób”) - poprawka DSP w jednym miejscu dla obu programów -->
    <Compile Include="..\src\AudioBalanceDsp.cs" Link="Silnik\AudioBalanceDsp.cs" />
    <Compile Include="..\src\AudioBalanceDynamics.cs" Link="Silnik\AudioBalanceDynamics.cs" />
    <Compile Include="..\src\AudioBalanceDynamicsUi.cs" Link="Silnik\AudioBalanceDynamicsUi.cs" />
    <Compile Include="..\src\AbStyl.cs" Link="AbStyl.cs" />
    <Compile Include="..\src\SuwakRolka.cs" Link="SuwakRolka.cs" />
    <Compile Include="..\src\AbWidok.cs" Link="AbWidok.cs" />
    <Compile Include="..\src\VelivoBledy.cs" Link="VelivoBledy.cs" />
    <Compile Include="..\src\CentrumZasobnik.cs" Link="CentrumZasobnik.cs" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="audiobalance.ico" />
    <Content Include="audiobalance.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
