<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- skladniki Windows (WinRT) potrzebne okienku "Film na wierzchu" z przezroczystoscia; dziala od Windows 10 1809 -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- ikonka w zasobniku (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <AssemblyName>Velivo</AssemblyName>
    <Product>Velivo</Product>
    <AssemblyTitle>Velivo Browser</AssemblyTitle>
    <Company>andro</Company>
    <RootNamespace>Przegladarka</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.22</Version>
    <!-- Velivo jest po polsku i angielsku: bez tlumaczen .NET/WPF na inne jezyki (ok. 12 folderow cs, de, ja, zh-Hans...) -->
    <SatelliteResourceLanguages>pl</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- testy bezpieczenstwa (testy/Velivo.Tests) wywoluja wewnetrzne funkcje programu -->
    <InternalsVisibleTo Include="Velivo.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
    <None Include="filters.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="UbolExtension\**\*" Condition="Exists('UbolExtension\manifest.json')">
      <Link>Dodatki\uBlock Origin Lite\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- pdf.js (Mozilla, Apache-2.0): tekst z PDF do trybu czytania i czytania na glos -->
    <Content Include="PdfJs\**\*">
      <Link>pdfjs\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="QuickAccessExtension\**\*">
      <Link>Dodatki\Szybki Dostęp\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
















