<Project Sdk="Microsoft.NET.Sdk">
  <!-- Velivo Kursory: samodzielny mały program - animowane kursory myszy w stylu Velivo (rysowane w programie, pliki .ani/.cur), zakłada je w Windows i przywraca kursory Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DebugType>none</DebugType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VelivoKursory</AssemblyName>
    <Product>Velivo Kursory</Product>
    <AssemblyTitle>Velivo Kursory</AssemblyTitle>
    <RootNamespace>VelivoKursory</RootNamespace>
    <ApplicationIcon>kursory.ico</ApplicationIcon>
    <Version>1.22</Version>
    <SatelliteResourceLanguages>pl</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\src\StartZWindows.cs" Link="StartZWindows.cs" />
    <Compile Include="..\src\CentrumZasobnik.cs" Link="CentrumZasobnik.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="kursory.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
