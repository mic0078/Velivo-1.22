<Project Sdk="Microsoft.NET.Sdk">
  <!-- Velivo Monitor: samodzielny mały program - sieć ↑↓, taktowanie i obciążenie procesora na pasku zadań i w widżecie na pulpicie (z wykresem z ostatniej minuty). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VelivoMonitor</AssemblyName>
    <Product>Velivo Monitor</Product>
    <AssemblyTitle>Velivo Monitor</AssemblyTitle>
    <RootNamespace>VelivoMonitor</RootNamespace>
    <ApplicationIcon>monitor.ico</ApplicationIcon>
    <Version>1.22</Version>
    <SatelliteResourceLanguages>pl</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="monitor.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
