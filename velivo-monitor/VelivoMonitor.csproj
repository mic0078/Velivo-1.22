<Project Sdk="Microsoft.NET.Sdk">
  <!-- Velivo Monitor: samodzielny mały program - sieć ↑↓, taktowanie i obciążenie procesora na pasku zadań i w widżecie na pulpicie (z wykresem z ostatniej minuty). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DebugType>none</DebugType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VelivoMonitor</AssemblyName>
    <Product>Velivo Monitor</Product>
    <AssemblyTitle>Velivo Monitor</AssemblyTitle>
    <RootNamespace>VelivoMonitor</RootNamespace>
    <ApplicationIcon>monitor.ico</ApplicationIcon>
    <Version>1.22</Version>
    <SatelliteResourceLanguages>pl</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- .NET Framework 4.8 jest w każdym Windows 10/11: program ma kilkadziesiąt KB zamiast 50 MB z dołączonym .NET -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\src\StartZWindows.cs" Link="StartZWindows.cs" />
    <Compile Include="..\src\CentrumZasobnik.cs" Link="CentrumZasobnik.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="monitor.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
